NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/ai-business-assistant
MONGO_URI_TEST=mongodb://127.0.0.1:27017/ai-business-assistant-test

JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_this_too_another_long_random_string_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=inclusionai/ling-3.0-flash-vl:free
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

FRONTEND_URL=http://localhost:3000
MAX_AGENT_STEPS=5
AGENT_TIMEOUT_MS=60000